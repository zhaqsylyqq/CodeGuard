# CodeGuard server settings. Edit this one file; every script in server/ reads it.
# Lines are plain shell: NAME="value". No spaces around "=".

# Which GPUs we may use, as numbered by nvidia-smi. Remove the ones that are busy.
GPUS="0 1 2 3 4 5"

# Length of the whole window in minutes (3.5 hours = 210, a night = 540).
WINDOW_MIN=210

# Per-GPU training batch and accumulation. BATCH x ACCUM must be 32.
# server/3_check.sh prints the recommended pair for this server; copy it here.
BATCH=8
ACCUM=4
EVAL_BATCH=16

# 33B model: 1 = download it and include its runs, 0 = skip. Needs about 70 GB of disk
# and two free GPUs.
WITH_33B=1

# Where Hugging Face keeps model weights. Leave empty for the default (~/.cache/huggingface).
# Set it if the home disk is small, e.g. HF_HOME="/data/hf"
HF_HOME=""
