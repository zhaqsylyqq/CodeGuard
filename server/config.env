# CodeGuard server settings. Edit this one file; every script in server/ reads it.
# Lines are plain shell: NAME="value". No spaces around "=".

# Which GPUs we may use, as numbered by nvidia-smi. Remove the ones that are busy.
GPUS="0 1 2 3 4 5"

# Length of the whole window in minutes (3.5 hours = 210, a night = 540). The plan makes every
# GPU queue finish, in the worst case, 20 minutes before the window ends.
WINDOW_MIN=210

# Per-GPU training batch and accumulation for the 6.7B runs. BATCH x ACCUM must be 32.
# server/3_check.sh prints the recommended pair for this server; copy it here.
# EVAL_BATCH is the generation / scoring batch (the 33B runs use at most 8).
BATCH=8
ACCUM=4
EVAL_BATCH=16

# 33B model: 1 = download it and run the 33B evaluation and QLoRA training on two GPU pairs,
# 0 = skip it (those four GPUs then run more 6.7B runs). Needs about 70 GB of disk and two free
# GPUs per 33B run. If server/3_check.sh says 33B does not fit or is too slow, set 0 here.
WITH_33B=1

# Where Hugging Face keeps model weights. Leave empty for the default (~/.cache/huggingface).
# Set it if the home disk is small, e.g. HF_HOME="/data/hf"
HF_HOME=""
